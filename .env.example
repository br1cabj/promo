# Copiá este archivo como .env y completá los datos.
PORT=3000
PANEL_USER=admin
PANEL_PASSWORD=cambia-esta-clave-larga

# Duración de la sesión en horas.
SESSION_HOURS=12

# Clave de cifrado de datos sensibles (teléfono/DNI) en reposo.
# Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la dejás vacía, el panel genera data/.key automáticamente (guardá ese archivo).
# IMPORTANTE: si la perdés, no se pueden leer los datos cifrados. No la cambies después.
ENCRYPTION_KEY=

# País por defecto para normalizar teléfonos (ISO 3166-1 alfa-2). Ej: AR, MX, ES.
DEFAULT_COUNTRY=AR

# URL de Evolution API, sin barra final. Ej: http://evolution-api:8080
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CAMBIAR_POR_TU_API_KEY
EVOLUTION_INSTANCE=promociones

# Máximo de archivo aceptado por el panel (MB)
MAX_UPLOAD_MB=25

# Máximo de imágenes/videos por campaña.
MAX_SEND_FILES=10

# Máximo de peso total de los archivos de una campaña (MB).
MAX_TOTAL_UPLOAD_MB=60

# Pausa entre envíos (ms) para reducir el riesgo de bloqueos por ráfagas.
# El retraso real es SEND_DELAY_MS + un valor aleatorio hasta SEND_DELAY_JITTER_MS.
SEND_DELAY_MS=1500
SEND_DELAY_JITTER_MS=2500

# Cada cuántos mensajes se hace un descanso más largo y cuánto dura (ms).
# 0 en SEND_BATCH_SIZE desactiva el descanso por tandas.
SEND_BATCH_SIZE=20
SEND_BATCH_PAUSE_MS=60000

# Confiar en X-Forwarded-* del proxy. Dejalo en false salvo que estés detrás de un proxy
# inverso (Coolify/nginx). Si lo activás sin proxy, se puede falsear la IP y evadir el rate limit.
TRUST_PROXY=false

# Carpeta de datos persistente (por defecto ./data dentro del contenedor).
# DATA_DIR=/app/data
