# =============================================================================
# Variables de entorno para el stack de Coolify (deploy/docker-compose.coolify.yml)
#
# Copiá y pegá estas variables en Coolify → tu recurso → Environment Variables.
# No hace falta subir este archivo con valores: es solo la lista de referencia.
# =============================================================================

# --- Panel -------------------------------------------------------------------
PANEL_USER=admin
PANEL_PASSWORD=cambia-esta-clave-larga-y-unica
# Clave de cifrado (64 hex). Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la dejás vacía, se genera en el volumen. Guardala: sin ella no se recuperan los datos.
ENCRYPTION_KEY=
DEFAULT_COUNTRY=AR
EVOLUTION_INSTANCE=promociones
SESSION_HOURS=12
# Opcional: URL pública exacta del panel (ej. https://panel.midominio.com).
# Solo hace falta si el panel rechaza con "Origen no permitido" detrás de un
# proxy que no informa X-Forwarded-Host.
PUBLIC_URL=

# --- Compartida entre el panel y Evolution API (deben coincidir) --------------
EVOLUTION_API_KEY=cambia-por-una-clave-larga-aleatoria

# --- PostgreSQL (base de datos de Evolution) ---------------------------------
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=cambia-por-otra-clave-larga

# --- Límites (pensados para un VPS chico) ------------------------------------
MAX_UPLOAD_MB=10
MAX_TOTAL_UPLOAD_MB=20
MAX_SEND_FILES=5

# --- Ritmo de envío (anti-bloqueo de WhatsApp) -------------------------------
SEND_DELAY_MS=1500
SEND_DELAY_JITTER_MS=2500
SEND_BATCH_SIZE=20
SEND_BATCH_PAUSE_MS=60000
